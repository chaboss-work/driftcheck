+    def _ollama_request_body(self, config: dict[str, Any]) -> dict[str, Any]:
+        provider = OllamaProvider()
+        request = LLMRequest.model_validate(
+            {"messages": [{"role": "user", "content": "hello"}]}
+        )
+        payload = {
+            "model": "qwen2.5:7b",
+            "message": {"role": "assistant", "content": "hello"},
+            "prompt_eval_count": 5,
+            "eval_count": 2,
+        }
+        captured: dict[str, Any] = {}
+
+        def _fake_urlopen(http_request, timeout=None):
+            del timeout
+            captured["body"] = json.loads(http_request.data.decode("utf-8"))
+            return _FakeHTTPResponse(payload)
+
+        with patch(
+            "openminion.modules.llm.providers.adapters.urllib_request.urlopen",
+            side_effect=_fake_urlopen,
+        ):
+            response = provider.complete(request, config)
+        self.assertTrue(response.ok)
+        return captured["body"]
+
+    def test_ollama_forwards_configured_num_ctx(self) -> None:
+        body = self._ollama_request_body(
+            {"base_url": "http://127.0.0.1:11434", "num_ctx": 16384}
+        )
+        self.assertEqual(body["options"]["num_ctx"], 16384)
+
+    def test_ollama_omits_num_ctx_when_not_configured(self) -> None:
+        for config in (
+            {"base_url": "http://127.0.0.1:11434"},
+            {"base_url": "http://127.0.0.1:11434", "num_ctx": 0},
+            {"base_url": "http://127.0.0.1:11434", "num_ctx": "not-a-number"},
+        ):
+            body = self._ollama_request_body(config)
+            self.assertNotIn("num_ctx", body["options"])
+

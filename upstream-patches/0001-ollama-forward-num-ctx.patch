+def _resolve_ollama_num_ctx(config: dict[str, Any]) -> int | None:
+    """Context window to request from Ollama (``options.num_ctx``).
+
+    Without it Ollama falls back to its server default context length, which
+    can be smaller than an OpenMinion turn (system prompt plus tool schemas).
+    Set it per connection with ``provider_config_overrides: {"num_ctx": 16384}``.
+    """
+    value = _as_int(config.get("num_ctx"), 0)
+    return value if value > 0 else None
+
